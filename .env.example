# Copy this file to .env and fill in real values for your machine.
# .env itself is gitignored - never commit real credentials.

# =========================
# Application
# =========================
APP_NAME=Hotel Booking System

# The server binds to PORT if set (the standard most hosting platforms -
# Render, Railway, Heroku, Koyeb, Fly, etc. - inject automatically), falling
# back to APP_PORT for local development, then 8080 if neither is set. Most
# platforms set PORT themselves - don't override it there.
APP_PORT=8081

# =========================
# Database
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=hotel_booking_db

# disable for local Postgres without SSL; use require (or your host's
# recommended mode) for a hosted/production database.
DB_SSLMODE=disable

# Connection pool limits (all optional - each falls back to a sane default
# below if unset, empty, or not a valid positive integer). Tune these to
# match your actual Postgres plan's connection limit and instance count.
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME_MINUTES=30

# =========================
# Auth
# =========================
# Use a long, random value in any real environment - this is a placeholder.
JWT_SECRET=changeme
JWT_EXPIRE=24h

# =========================
# CORS
# =========================
# The single origin the frontend is served from. Must be an exact origin
# (scheme + host + port), not a wildcard, since requests are credentialed.
FRONTEND_URL=http://localhost:5173

# =========================
# Image Storage (Cloudinary)
# =========================
# Get these from your Cloudinary dashboard (Settings > API Keys). Hotel
# image upload/delete stays disabled with a clear error until all three
# are set - every other endpoint works fine without them.
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme
